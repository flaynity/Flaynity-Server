{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://flaynity.indevs.in"
        ],
        "methods": [
          "GET",
          "HEAD",
          "PUT"
        ],
        "headers": [
          "Content-Type"
        ]
      },
      "exposeHeaders": [
        "ETag"
      ],
      "maxAgeSeconds": 86400
    }
  ]
}
